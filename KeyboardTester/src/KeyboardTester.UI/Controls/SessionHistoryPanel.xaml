<UserControl x:Class="KeyboardTester.UI.Controls.SessionHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KeyboardTester.UI.Converters"
             xmlns:res="clr-namespace:KeyboardTester.UI.Resources">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <converters:KeyStatusToDescriptionConverter x:Key="StatusToDescription"/>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                  ItemsSource="{Binding SessionHistory}"
                  SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnName}" DisplayMemberBinding="{Binding DisplayName}" Width="140"/>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnDate}" DisplayMemberBinding="{Binding FormattedDate}" Width="120"/>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnDuration}"
                                    DisplayMemberBinding="{Binding Session.Duration, StringFormat=hh\:mm\:ss}" Width="90"/>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnPresses}" DisplayMemberBinding="{Binding TotalPressCount}" Width="70"/>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnProblematic}" DisplayMemberBinding="{Binding ProblematicKeysCount}" Width="90"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6">
            <Button Content="{x:Static res:Strings.SaveCurrentSession}" Padding="10,4" Margin="0,0,6,0"
                    Foreground="{DynamicResource TextBrush}"
                    Command="{Binding SaveSessionCommand}"/>
            <Button Content="{x:Static res:Strings.Delete}" Padding="10,4" Margin="0,0,6,0" Click="DeleteButton_Click"
                    Foreground="{DynamicResource TextBrush}"/>
            <Button Content="{x:Static res:Strings.CompareLastTwo}" Padding="10,4"
                    Foreground="{DynamicResource TextBrush}"
                    Command="{Binding CompareSessionsCommand}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Visibility="{Binding LastComparison, Converter={StaticResource NullToVisibility}}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.ComparisonTitle}" FontWeight="Bold" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding LastComparison.PressCountDelta, StringFormat={x:Static res:Strings.ComparisonPressDelta}}"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding LastComparison.ProblematicKeysDelta, StringFormat={x:Static res:Strings.ComparisonProblematicDelta}}"
                            Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{x:Static res:Strings.ComparisonStatusChanges}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LastComparison.KeyStatusChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Key.DisplayName}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding OldStatus, Converter={StaticResource StatusToDescription}}"/>
                                    <TextBlock Text=" → " xml:space="preserve"/>
                                    <TextBlock Text="{Binding NewStatus, Converter={StaticResource StatusToDescription}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
