<UserControl x:Class="KeyboardTester.UI.Controls.SessionHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KeyboardTester.UI.Converters"
             xmlns:res="clr-namespace:KeyboardTester.UI.Resources">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <converters:KeyStatusToDescriptionConverter x:Key="StatusToDescription"/>
        <converters:KeyStatusToBrushConverter x:Key="StatusToBrush"/>
        <converters:KeyboardLayoutToDescriptionConverter x:Key="LayoutToDescription"/>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                  ItemsSource="{Binding SessionHistory}"
                  SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnName}" DisplayMemberBinding="{Binding DisplayName}" Width="140"/>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnDate}" DisplayMemberBinding="{Binding FormattedDate}" Width="120"/>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnDuration}"
                                    DisplayMemberBinding="{Binding Session.Duration, StringFormat=hh\:mm\:ss}" Width="90"/>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnPresses}" DisplayMemberBinding="{Binding TotalPressCount}" Width="70"/>
                    <GridViewColumn Header="{x:Static res:Strings.ColumnProblematic}" DisplayMemberBinding="{Binding ProblematicKeysCount}" Width="90"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6">
            <Button Content="{x:Static res:Strings.SaveCurrentSession}" Padding="10,4" Margin="0,0,6,0"
                    Command="{Binding SaveSessionCommand}"/>
            <Button Content="{x:Static res:Strings.Delete}" Padding="10,4" Margin="0,0,6,0" Click="DeleteButton_Click"/>
            <Button Content="{x:Static res:Strings.CompareLastTwo}" Padding="10,4"
                    Command="{Binding CompareSessionsCommand}"/>
        </StackPanel>

        <!-- Просмотр истории: развёрнутая панель деталей выбранной сессии (v1.1.0) -->
        <Expander Grid.Row="2"
                  Margin="0,4"
                  IsExpanded="{Binding IsSessionDetailsExpanded, Mode=TwoWay}"
                  Visibility="{Binding SelectedSession, Converter={StaticResource NullToVisibility}}"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="1"
                  Padding="4">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.SessionDetailsTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text=" — " Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{Binding SelectedSession.DisplayName}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Expander.Header>

            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Метаданные сессии -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SessionDetailLabels"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SessionDetailLabels"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SessionDetailLabels"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SessionStartLabel}" FontWeight="SemiBold"
                               Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedSession.Session.StartTime, StringFormat=g}" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Grid.Column="2" Text="{x:Static res:Strings.SessionEndLabel}" FontWeight="SemiBold"
                               Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Grid.Column="3" Margin="0,0,16,0"
                               Text="{Binding SelectedSession.Session.EndTime, StringFormat=g, TargetNullValue={x:Static res:Strings.NotFinishedMark}}"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Grid.Column="4" Text="{x:Static res:Strings.SessionLayoutLabel}" FontWeight="SemiBold"
                               Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Grid.Column="5"
                               Text="{Binding SelectedSession.Session.Layout, Converter={StaticResource LayoutToDescription}}"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>

                <!-- Заметки -->
                <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{Binding SelectedSession.Session.Notes, TargetNullValue={x:Static res:Strings.SessionNotesEmpty}}"/>

                <!-- Сводка -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,4">
                    <TextBlock Text="{x:Static res:Strings.ColumnDuration}" FontWeight="SemiBold" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{Binding SelectedSession.Session.Duration, StringFormat=hh\:mm\:ss}" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{x:Static res:Strings.ColumnPresses}" FontWeight="SemiBold" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{Binding SelectedSession.TotalPressCount}" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{x:Static res:Strings.SessionTestedKeysLabel}" FontWeight="SemiBold" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{Binding SelectedSession.StatisticsList.Count}"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>

                <!-- Статистика клавиш сессии -->
                <DataGrid Grid.Row="3"
                          MinHeight="120" MaxHeight="260"
                          ItemsSource="{Binding SelectedSession.StatisticsList}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnKey}" Binding="{Binding Key.DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnPressCount}" Binding="{Binding PressCount}" Width="Auto"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnAvgInterval}"
                                            Binding="{Binding AverageIntervalMs, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnAvgHold}"
                                            Binding="{Binding AverageHoldDurationMs, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnChatter}" Binding="{Binding ChatterEvents.Count}" Width="Auto"/>
                        <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnStatus}" Width="*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,2" CornerRadius="3" HorizontalAlignment="Stretch"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Foreground="White" TextAlignment="Center"
                                                   Text="{Binding Status, Converter={StaticResource StatusToDescription}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Expander>

        <Border Grid.Row="3"
                Visibility="{Binding LastComparison, Converter={StaticResource NullToVisibility}}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.ComparisonTitle}" FontWeight="Bold" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding LastComparison.PressCountDelta, StringFormat={x:Static res:Strings.ComparisonPressDelta}}"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding LastComparison.ProblematicKeysDelta, StringFormat={x:Static res:Strings.ComparisonProblematicDelta}}"
                            Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{x:Static res:Strings.ComparisonStatusChanges}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LastComparison.KeyStatusChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Key.DisplayName}" FontWeight="SemiBold" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding OldStatus, Converter={StaticResource StatusToDescription}}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text=" → " xml:space="preserve" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding NewStatus, Converter={StaticResource StatusToDescription}}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
