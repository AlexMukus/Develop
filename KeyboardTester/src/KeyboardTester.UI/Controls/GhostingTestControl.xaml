<UserControl x:Class="KeyboardTester.UI.Controls.GhostingTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:KeyboardTester.UI.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Инструкция -->
        <TextBlock Grid.Row="0"
                   Text="{x:Static res:Strings.GhostingInstruction}"
                   TextWrapping="Wrap" Margin="10" FontSize="14"/>

        <!-- Матрица клавиш -->
        <Viewbox Grid.Row="1" Margin="20" Stretch="Uniform">
            <Canvas x:Name="GhostingCanvas"/>
        </Viewbox>

        <!-- Статистика -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="{x:Static res:Strings.GhostingPressed}" FontSize="16" xml:space="preserve"/>
            <TextBlock Text="{Binding GhostingPressedCount}" FontSize="16" FontWeight="Bold" Margin="0,0,20,0"/>
            <TextBlock Text="{x:Static res:Strings.GhostingMax}" FontSize="16" xml:space="preserve"/>
            <TextBlock Text="{Binding GhostingMaxCount}" FontSize="16" FontWeight="Bold" Margin="0,0,20,0"/>
            <TextBlock Text="{x:Static res:Strings.NKRO}" FontSize="16" xml:space="preserve"/>
            <TextBlock Text="{Binding IsNKeyRollover}" FontSize="16" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
