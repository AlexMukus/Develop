<UserControl x:Class="KeyboardTester.UI.Controls.StatisticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KeyboardTester.UI.Converters"
             xmlns:res="clr-namespace:KeyboardTester.UI.Resources">
    <UserControl.Resources>
        <converters:KeyStatusToBrushConverter x:Key="StatusToBrush"/>
        <converters:KeyStatusToDescriptionConverter x:Key="StatusToDescription"/>
        <CollectionViewSource x:Key="StatisticsView"
                              Source="{Binding Statistics}"
                              Filter="StatisticsView_Filter"/>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ComboBox x:Name="FilterCombo"
                  Grid.Row="0"
                  SelectedIndex="0"
                  Margin="0,0,0,6"
                  SelectionChanged="FilterCombo_SelectionChanged">
            <ComboBoxItem Content="{x:Static res:Strings.FilterAll}"/>
            <ComboBoxItem Content="{x:Static res:Strings.FilterProblematic}"/>
            <ComboBoxItem Content="{x:Static res:Strings.FilterNotTested}"/>
        </ComboBox>

        <DataGrid x:Name="StatisticsGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Source={StaticResource StatisticsView}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  MouseDoubleClick="StatisticsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnKey}" Binding="{Binding Key.DisplayName}" Width="Auto"/>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnPressCount}" Binding="{Binding PressCount}" Width="Auto"/>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnAvgInterval}"
                                    Binding="{Binding AverageIntervalMs, StringFormat=F1}" Width="Auto"/>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnAvgHold}"
                                    Binding="{Binding AverageHoldDurationMs, StringFormat=F1}" Width="Auto"/>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnChatter}" Binding="{Binding ChatterEvents.Count}" Width="Auto"/>
                <!-- DataGridTemplateColumn с Width="Auto" не измеряет шаблон (дефект WPF):
                     колонка Статус растягивается на всё свободное место, чтобы
                     помещалось полное сообщение («Критическая проблема»). -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnStatus}" Width="*" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="8,2" CornerRadius="3" HorizontalAlignment="Stretch"
                                    Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                <TextBlock Foreground="White"
                                           TextAlignment="Center"
                                           Text="{Binding Status, Converter={StaticResource StatusToDescription}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
