<UserControl x:Class="KeyboardTester.UI.Controls.ChartsPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Интервалы между нажатиями, мс" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <lvc:CartesianChart x:Name="IntervalChart" Grid.Row="1"/>
        </Grid>

        <Grid Grid.Column="1" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Время удержания, мс" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <lvc:CartesianChart x:Name="HoldChart" Grid.Row="1"/>
        </Grid>

        <TextBlock x:Name="EmptyHint"
                   Grid.ColumnSpan="2"
                   Text="Нет данных. Запустите тест и нажимайте клавиши."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Opacity="0.6"/>
    </Grid>
</UserControl>
