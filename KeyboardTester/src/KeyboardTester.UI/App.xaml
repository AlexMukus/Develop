<Application x:Class="KeyboardTester.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Общие стили контролов на кистях тем.
                     Словари тем (Dark/Light) добавляет ThemeManager в рантайме. -->
                <ResourceDictionary Source="/KeyboardTester.UI;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
