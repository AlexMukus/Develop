<Window x:Class="KeyboardTester.UI.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KeyboardTester.UI.Resources"
        Title="{x:Static res:Strings.SettingsTitle}"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.ThresholdCritical}"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
        <TextBox x:Name="CriticalThresholdBox" Grid.Row="0" Grid.Column="1" Margin="0,2"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.ThresholdWarning}"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
        <TextBox x:Name="WarningThresholdBox" Grid.Row="1" Grid.Column="1" Margin="0,2"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.ThresholdMild}"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
        <TextBox x:Name="MildThresholdBox" Grid.Row="2" Grid.Column="1" Margin="0,2"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.ThresholdStuck}"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
        <TextBox x:Name="StuckThresholdBox" Grid.Row="3" Grid.Column="1" Margin="0,2"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Strings.MaxEvents}"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
        <TextBox x:Name="MaxEventsBox" Grid.Row="4" Grid.Column="1" Margin="0,2"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static res:Strings.Theme}"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
        <ComboBox x:Name="ThemeCombo" Grid.Row="5" Grid.Column="1" Margin="0,2">
            <ComboBoxItem Content="{x:Static res:Strings.ThemeSystem}"/>
            <ComboBoxItem Content="{x:Static res:Strings.ThemeDark}"/>
            <ComboBoxItem Content="{x:Static res:Strings.ThemeLight}"/>
        </ComboBox>

        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{x:Static res:Strings.SettingsRestartHint}"
                   Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,4"
                   Foreground="{DynamicResource TextBrush}"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static res:Strings.Save}" Padding="14,4" Margin="0,0,8,0"
                    Foreground="{DynamicResource TextBrush}"
                    IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="{x:Static res:Strings.Cancel}" Padding="14,4" IsCancel="True"
                    Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
