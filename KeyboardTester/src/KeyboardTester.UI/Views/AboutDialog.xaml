<Window x:Class="KeyboardTester.UI.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KeyboardTester.UI.Resources"
        Title="{x:Static res:Strings.AboutTitle}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static res:Strings.AppTitle}"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"/>

        <TextBlock x:Name="VersionText"
                   Margin="0,4,0,8"
                   Foreground="{DynamicResource TextBrush}"/>

        <TextBlock TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"
                   Text="{x:Static res:Strings.AboutDescription}"/>

        <TextBlock Text="{x:Static res:Strings.License}"
                   Margin="0,4,0,8"
                   Foreground="{DynamicResource TextBrush}"/>

        <TextBlock Text="{x:Static res:Strings.UsedLibraries}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock TextWrapping="Wrap"
                   Opacity="0.8"
                   Foreground="{DynamicResource TextBrush}"
                   Text="{x:Static res:Strings.UsedLibrariesList}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.Close}" Padding="12,4" IsCancel="True"
                    Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
    </StackPanel>
</Window>
