<Window x:Class="KeyboardTester.UI.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Keyboard Tester Pro"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"/>

        <TextBlock x:Name="VersionText"
                   Margin="0,4,0,8"
                   Foreground="{DynamicResource TextBrush}"/>

        <TextBlock TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"
                   Text="Утилита для тестирования клавиатур: регистрация нажатий, диагностика дребезга и залипания клавиш, тест на ghosting (NKRO/6KRO), история сессий."/>

        <TextBlock Margin="0,10,0,0">
            <Run Foreground="{DynamicResource TextBrush}">Репозиторий:</Run>
            <Hyperlink x:Name="GitHubLink" Click="GitHubLink_Click">github.com/yourusername/KeyboardTester</Hyperlink>
        </TextBlock>

        <TextBlock Text="Лицензия MIT"
                   Margin="0,4,0,8"
                   Foreground="{DynamicResource TextBrush}"/>

        <TextBlock Text="Используемые библиотеки:"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock TextWrapping="Wrap"
                   Opacity="0.8"
                   Foreground="{DynamicResource TextBrush}"
                   Text="CommunityToolkit.Mvvm (MIT), LiveCharts2 (MIT), Serilog (Apache-2.0), SkiaSharp (MIT)."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Проверить обновления" Padding="12,4" Margin="0,0,8,0"
                    Click="CheckUpdates_Click"/>
            <Button Content="Закрыть" Padding="12,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
