<Window x:Class="KeyboardTester.UI.Views.LayoutProposalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KeyboardTester.UI.Resources"
        Title="{x:Static res:Strings.LayoutProposalTitle}"
        MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SuggestedText" Grid.Row="0"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextBrush}"/>

        <ComboBox x:Name="LayoutCombo" Grid.Row="1" Margin="0,0,0,10"/>

        <CheckBox x:Name="RememberCheckBox" Grid.Row="2" Margin="0,0,0,12"
                  Foreground="{DynamicResource TextBrush}"
                  Content="{x:Static res:Strings.LayoutProposalRemember}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.Save}" Padding="14,4" Margin="0,0,8,0"
                    Foreground="{DynamicResource TextBrush}"
                    IsDefault="True" Click="OkButton_Click"/>
            <Button Content="{x:Static res:Strings.DetectionCancel}" Padding="14,4" IsCancel="True"
                    Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
