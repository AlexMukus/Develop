<Window x:Class="KeyboardTester.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KeyboardTester.UI.Controls"
        xmlns:converters="clr-namespace:KeyboardTester.UI.Converters"
        xmlns:res="clr-namespace:KeyboardTester.UI.Resources"
        Title="{x:Static res:Strings.AppTitle}"
        Width="1400" Height="900"
        MinWidth="1200" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}">
            <TextBlock Text="{x:Static res:Strings.Layout}" VerticalAlignment="Center" Margin="4,0,2,0"
                       Foreground="{DynamicResource TextBrush}"/>
            <ComboBox ItemsSource="{Binding AvailableLayouts}"
                      SelectedItem="{Binding SelectedLayout}"
                      Width="110" Margin="0,0,4,0"/>
            <Separator/>
            <TextBlock Text="{x:Static res:Strings.Keyboard}" VerticalAlignment="Center" Margin="4,0,2,0"
                       Foreground="{DynamicResource TextBrush}"/>
            <ComboBox ItemsSource="{Binding ConnectedKeyboards}"
                      SelectedItem="{Binding SelectedKeyboard}"
                      Width="220" Margin="0,0,4,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ProductName, TargetNullValue={x:Static res:Strings.KeyboardFallback}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Separator/>
            <Button Content="{x:Static res:Strings.StartTest}" Command="{Binding StartTestCommand}" Margin="2,0"
                    Foreground="{DynamicResource TextBrush}"
                    IsEnabled="{Binding IsSessionRunning, Converter={StaticResource InverseBoolConverter}}"/>
            <Button Content="{x:Static res:Strings.StopTest}" Command="{Binding StopTestCommand}" Margin="2,0"
                    Foreground="{DynamicResource TextBrush}"
                    IsEnabled="{Binding IsSessionRunning}"/>
            <Button Content="{x:Static res:Strings.ResetTest}" Command="{Binding ResetCommand}" Margin="2,0"
                    Foreground="{DynamicResource TextBrush}"/>
            <Separator/>
            <Button Content="{x:Static res:Strings.GhostingTest}" Command="{Binding StartGhostingTestCommand}" Margin="2,0"
                    Foreground="{DynamicResource TextBrush}"
                    IsEnabled="{Binding IsGhostingTestActive, Converter={StaticResource InverseBoolConverter}}"/>
            <Button Content="{x:Static res:Strings.GhostingTestStop}" Command="{Binding StopGhostingTestCommand}" Margin="2,0"
                    Foreground="{DynamicResource TextBrush}"
                    IsEnabled="{Binding IsGhostingTestActive}"/>
            <Separator/>
            <Button Content="{x:Static res:Strings.Settings}" Command="{Binding OpenSettingsCommand}" Margin="2,0"
                    Foreground="{DynamicResource TextBrush}"/>
            <Button Content="{x:Static res:Strings.About}" Command="{Binding OpenAboutCommand}" Margin="2,0"
                    Foreground="{DynamicResource TextBrush}"/>
        </ToolBar>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="500"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Virtual Keyboard + Charts/Ghosting -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:VirtualKeyboardControl Grid.Row="0" Margin="10,10,10,0"/>

                <TabControl Grid.Row="1" Margin="10">
                    <TabItem Header="{x:Static res:Strings.TabCharts}">
                        <controls:ChartsPanelControl/>
                    </TabItem>
                    <TabItem Header="{x:Static res:Strings.TabGhosting}"
                             IsSelected="{Binding IsGhostingTestActive, Mode=TwoWay}">
                        <controls:GhostingTestControl/>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Right: Statistics + History -->
            <TabControl Grid.Column="1" Margin="0,10,10,10">
                <TabItem Header="{x:Static res:Strings.TabStatistics}">
                    <controls:StatisticsPanel/>
                </TabItem>
                <TabItem Header="{x:Static res:Strings.TabHistory}">
                    <controls:SessionHistoryPanel/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}">
            <TextBlock Text="{Binding SessionDuration, StringFormat={x:Static res:Strings.Duration}}"
                       Foreground="{DynamicResource TextBrush}"/>
            <Separator/>
            <TextBlock Text="{Binding TotalPressCount, StringFormat={x:Static res:Strings.TotalPresses}}"
                       Foreground="{DynamicResource TextBrush}"/>
            <Separator/>
            <TextBlock Text="{Binding ProblematicKeysCount, StringFormat={x:Static res:Strings.ProblematicKeys}}"
                       Foreground="{DynamicResource TextBrush}"/>
            <Separator/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextBrush}"/>
        </StatusBar>
    </Grid>
</Window>
