<Window x:Class="KeyboardTester.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KeyboardTester.UI.Controls"
        xmlns:converters="clr-namespace:KeyboardTester.UI.Converters"
        Title="Keyboard Tester Pro"
        Width="1400" Height="900"
        MinWidth="1200" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}">
            <TextBlock Text="Раскладка:" VerticalAlignment="Center" Margin="4,0,2,0"
                       Foreground="{DynamicResource TextBrush}"/>
            <ComboBox ItemsSource="{Binding AvailableLayouts}"
                      SelectedItem="{Binding SelectedLayout}"
                      Width="110" Margin="0,0,4,0"/>
            <Separator/>
            <TextBlock Text="Клавиатура:" VerticalAlignment="Center" Margin="4,0,2,0"
                       Foreground="{DynamicResource TextBrush}"/>
            <ComboBox ItemsSource="{Binding ConnectedKeyboards}"
                      SelectedItem="{Binding SelectedKeyboard}"
                      Width="220" Margin="0,0,4,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ProductName, TargetNullValue='Клавиатура'}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Separator/>
            <Button Content="▶ Начать тест" Command="{Binding StartTestCommand}" Margin="2,0"
                    IsEnabled="{Binding IsSessionRunning, Converter={StaticResource InverseBoolConverter}}"/>
            <Button Content="⏹ Остановить" Command="{Binding StopTestCommand}" Margin="2,0"
                    IsEnabled="{Binding IsSessionRunning}"/>
            <Button Content="🔄 Сбросить" Command="{Binding ResetCommand}" Margin="2,0"/>
            <Separator/>
            <Button Content="👻 Ghosting Test" Command="{Binding StartGhostingTestCommand}" Margin="2,0"
                    IsEnabled="{Binding IsGhostingTestActive, Converter={StaticResource InverseBoolConverter}}"/>
            <Button Content="⏹ Стоп Ghosting" Command="{Binding StopGhostingTestCommand}" Margin="2,0"
                    IsEnabled="{Binding IsGhostingTestActive}"/>
            <Separator/>
            <Button Content="⚙ Настройки" Command="{Binding OpenSettingsCommand}" Margin="2,0"/>
            <Button Content="❓ О программе" Command="{Binding OpenAboutCommand}" Margin="2,0"/>
        </ToolBar>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="500"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Virtual Keyboard + Charts/Ghosting -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:VirtualKeyboardControl Grid.Row="0" Margin="10,10,10,0"/>

                <TabControl Grid.Row="1" Margin="10">
                    <TabItem Header="📊 Графики">
                        <controls:ChartsPanelControl/>
                    </TabItem>
                    <TabItem Header="👻 Ghosting Test"
                             IsSelected="{Binding IsGhostingTestActive, Mode=OneWay}">
                        <controls:GhostingTestControl/>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Right: Statistics + History -->
            <TabControl Grid.Column="1" Margin="0,10,10,10">
                <TabItem Header="📋 Статистика">
                    <controls:StatisticsPanel/>
                </TabItem>
                <TabItem Header="📁 История">
                    <controls:SessionHistoryPanel/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}">
            <TextBlock Text="{Binding SessionDuration, StringFormat='Длительность: {0:hh\\:mm\\:ss}'}"
                       Foreground="{DynamicResource TextBrush}"/>
            <Separator/>
            <TextBlock Text="{Binding TotalPressCount, StringFormat='Всего нажатий: {0}'}"
                       Foreground="{DynamicResource TextBrush}"/>
            <Separator/>
            <TextBlock Text="{Binding ProblematicKeysCount, StringFormat='Проблемных клавиш: {0}'}"
                       Foreground="{DynamicResource TextBrush}"/>
            <Separator/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextBrush}"/>
        </StatusBar>
    </Grid>
</Window>
